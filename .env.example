# ---- Devin API ----
# Required at runtime to create real Devin sessions. Provided as an org secret
# during the demo. NEVER commit a real key. Tests run fully mocked and do not
# need this value.
DEVIN_API_KEY=your-devin-api-key

# Base URL for the Devin API (rarely needs changing).
DEVIN_API_BASE=https://api.devin.ai/v1

# ---- GitHub ----
# Optional. Used only by simulate.py to fetch real issues from the GitHub API.
# A classic token with "repo" scope (or fine-grained read access) raises rate
# limits and allows reading private repos. Public issues work without it.
GITHUB_TOKEN=

# ---- Remediation behaviour ----
# The repository that Devin sessions should fix.
TARGET_REPO=acrouch8090/superset

# Label that triggers remediation.
TRIGGER_LABEL=devin-fix

# Base branch that generated PRs target.
DEFAULT_BASE_BRANCH=master

# ---- Storage / polling ----
# Path to the SQLite database file.
DATABASE_PATH=data/remediation.db

# How often (seconds) the background poller refreshes active session statuses.
POLL_INTERVAL_SECONDS=30
